# ========================================
# Roan's Banking Dashboard - Configuration
# ========================================
# Copy this file to .env and fill in your values.
# DO NOT commit .env to git.

# Port for the dashboard (default: 8200)
APP_PORT=8200

# === Enable Banking (REQUIRED) ===
# Sign up: https://enablebanking.com
# Create an application in the dashboard.
# Set the redirect URL to: http://localhost:${APP_PORT}/api/auth/callback

# Your Enable Banking application ID
ENABLE_BANKING_APP_ID=your_app_id_here

# Path to your private key PEM file inside the container
# This is mounted from ./config/private.pem on the host
PRIVATE_KEY_PATH=/app/config/private.pem
