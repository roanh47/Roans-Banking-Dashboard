# Enable Banking application ID (required)
# Create an app at https://enablebanking.com and set redirect URI to http://localhost:8200/api/auth/callback
ENABLE_BANKING_APP_ID=your_app_id_here

# BankBot - AI assistant (optional)
# Any OpenAI-compatible API endpoint + key
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
